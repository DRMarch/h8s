{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "argocd": {
        "managerFilePatterns": [
            "/^ci-cd\\/argo-cd\\/.+\\.ya?ml$/"
        ]
    },
    "automerge": false,
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "helm",
            "depNameTemplate": "argo-cd",
            "description": "Update Argo CD Helm chart version in README install snippet",
            "managerFilePatterns": [
                "/^ci-cd/argo-cd/README\\.md$/"
            ],
            "matchStrings": [
                "export ARGOCD_HELM_VER=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
            ],
            "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
        },
        {
            "customType": "regex",
            "description": "Update Gateway API CRDs in kustomization.yaml",
            "fileMatch": [
                "kustomization\\.yaml$"
            ],
            "matchStrings": [
                "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/refs/tags/(?<currentValue>v[0-9.]+)/"
            ],
            "datasourceTemplate": "github-tags"
        },
        {
            "customType": "regex",
            "description": "Track the Devbox CLI version in devbox.json",
            "fileMatch": [
                "^devbox\\.json$"
            ],
            "matchStrings": [
                "jetify-com/devbox/(?<currentValue>\\d+\\.\\d+\\.\\d+)/\\.schema/devbox\\.schema\\.json"
            ],
            "depNameTemplate": "devbox",
            "datasourceTemplate": "devbox"
        }
    ],
    "dependencyDashboard": true,
    "dependencyDashboardTitle": "Renovate Dependency Dashboard",
    "enabledManagers": [
        "argocd",
        "custom.regex",
        "devbox",
        "dockerfile",
        "helm-values",
        "kubernetes",
        "kustomize",
        "terraform"
    ],
    "extends": [
        "config:recommended"
    ],
    "helm-values": {
        "managerFilePatterns": [
            "/(^|/)values\\.ya?ml$/"
        ]
    },
    "kubernetes": {
        "managerFilePatterns": [
            "/.*\\.yaml$/",
            "/.*\\.yml$/"
        ]
    },
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Label major updates for manual review",
            "labels": [
                "dependencies",
                "major-update"
            ],
            "matchUpdateTypes": [
                "major"
            ]
        },
        {
            "description": "Ensure OCI Helm chart from ghcr.io/grafana is processed",
            "enabled": true,
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/grafana/helm-charts/grafana-operator"
            ]
        },
        {
            "description": "Only update Renovate itself on minor/major releases",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "renovate/renovate"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "enabled": false
        }
    ],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "rebaseWhen": "behind-base-branch",
    "terraform": {
        "managerFilePatterns": [
            "terraform/*"
        ]
    }
}