# GENERATED by terraform/higress-api-keys — do not edit by hand.
apiVersion: extensions.higress.io/v1alpha1
kind: WasmPlugin
metadata:
  name: key-auth
  namespace: higress-system
spec:
  url: oci://higress-registry.us-west-1.cr.aliyuncs.com/plugins/key-auth:2.0.0
  imagePullPolicy: IfNotPresent
  failStrategy: FAIL_CLOSE
  priority: 1000
  defaultConfigDisable: true
  matchRules:
    # External
    - domain:
        - llm.drmarchent.com
      config:
        consumers:
%{ for consumer in external_consumers ~}
          - name: ${consumer}-bearer
            credential: "Bearer $${secret.higress-system/higress-api-keys.${consumer}}"
          - name: ${consumer}
            credential: $${secret.higress-system/higress-api-keys.${consumer}}
%{ endfor ~}
        keys:
          - authorization
          - x-api-key
        in_query: false
        in_header: true
    # Internal
    - domain:
        - higress-internal.higress-system.svc.cluster.local
      config:
        consumers:
%{ for consumer in internal_consumers ~}
          - name: ${consumer}-bearer
            credential: "Bearer $${secret.higress-system/higress-api-keys.${consumer}}"
          - name: ${consumer}
            credential: $${secret.higress-system/higress-api-keys.${consumer}}
%{ endfor ~}
        keys:
          - authorization
          - x-api-key
        in_query: false
        in_header: true
