apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: higress-opencode-go
  namespace: higress-system
spec:
  refreshInterval: 5m
  secretStoreRef:
    name: vault-cluster-secretstore
    kind: ClusterSecretStore
  target:
    name: higress-opencode-go
    creationPolicy: Orphan
    deletionPolicy: Retain
  data:
%{ for i in range(1, token_count + 1) ~}
    - secretKey: api-token-${i}
      remoteRef:
        key: higress/opencode-go
        property: api-token-${i}
%{ endfor ~}
